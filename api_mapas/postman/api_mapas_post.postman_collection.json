{
  "info": {
    "name": "api_mapas - POST (cria linhas)",
    "description": "POST /api/mapas/graphy e /api/mapas/metry. ATENCAO: CRIA 2 ids novos por execucao em public.mapas, e a API nao apaga linhas. So roda com permitirCriacao=sim. Os ids criados ficam em idsCriados e sao impressos no console da ultima requisicao, com o SQL de limpeza (api_mapas/README.md, 'Limpeza de ids criados'). 6 escritas por execucao, dentro do limite de 10/min. Nenhuma credencial nesta colecao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ((pm.variables.get('permitirCriacao') || '').trim() !== 'sim') {",
          "  console.warn('permitirCriacao diferente de sim: requisicao pulada (esta colecao CRIA linhas).');",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// RA-17: cabecalhos de seguranca em todas as respostas",
          "pm.test('X-Content-Type-Options: nosniff', function () {",
          "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
          "});",
          "pm.test('Cache-Control: no-store', function () {",
          "    pm.expect(pm.response.headers.get('Cache-Control') || '').to.include('no-store');",
          "});",
          "pm.test('sem header Server', () => pm.expect(pm.response.headers.has('Server')).to.be.false);",
          "if (pm.response.code >= 400) {",
          "  pm.test('problem+json com traceId e sem vazamento', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/problem+json');",
          "    const j = pm.response.json();",
          "    pm.expect(j.traceId).to.be.a('string').and.not.empty;",
          "    const t = pm.response.text();",
          "    ['Npgsql', 'SqlState', 'Exception', 'password', 'POINT(', 'POLYGON(', 'LINESTRING('].forEach(x => pm.expect(t).to.not.include(x));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string"
    },
    {
      "key": "permitirCriacao",
      "value": "",
      "type": "string",
      "description": "Defina 'sim' para rodar. Qualquer outro valor pula todas as requisicoes."
    },
    {
      "key": "idCriadoGraphy",
      "value": "",
      "type": "string",
      "description": "Preenchido pelo POST de graphy (Location)."
    },
    {
      "key": "idCriadoMetry",
      "value": "",
      "type": "string",
      "description": "Preenchido pelo POST de metry (Location)."
    },
    {
      "key": "idsCriados",
      "value": "",
      "type": "string",
      "description": "Lista acumulada dos ids criados, para a limpeza."
    }
  ],
  "item": [
    {
      "name": "graphy - POST 201 (cria id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 sem corpo', () => { pm.response.to.have.status(201); pm.expect(pm.response.text()).to.eql(''); });",
              "const loc = pm.response.headers.get('Location') || '';",
              "const m = /^\\/api\\/mapas\\/(\\d+)\\/(graphy|metry)$/.exec(loc);",
              "pm.test('Location relativo /api/mapas/{id}/graphy', function () {",
              "    pm.expect(m, 'Location = ' + loc).to.not.be.null;",
              "    pm.expect(m[2]).to.eql('graphy');",
              "});",
              "if (m) {",
              "    pm.collectionVariables.set('idCriadoGraphy', m[1]);",
              "    const lista = (pm.collectionVariables.get('idsCriados') || '').split(',').filter(x => x);",
              "    lista.push(m[1]);",
              "    pm.collectionVariables.set('idsCriados', lista.join(','));",
              "    console.log('id criado (anote para a limpeza): ' + m[1]);",
              "}"
            ]
          }
        }
      ],
