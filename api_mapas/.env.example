# Exemplo SOMENTE com placeholders (RA-15). NAO copie para .env com valores reais:
# defina as variaveis no shell da sessao (ver README). A API nao le arquivos .env.
PG_HOST=<host_do_postgres>
PG_PORT=5432
PG_DATABASE=<base>
PG_USER=<defina_no_shell>
PG_PASSWORD=<defina_no_shell>
PG_SSLMODE=Require
# Escrita (PUT e POST), opcional. Sem as duas, a escrita fica desligada (PUT 405, POST 404).
# Defina as duas ou nenhuma. Usuario e senha DIFERENTES de PG_USER/PG_PASSWORD (role api_mapas_escrita,
# roles.sql revisao 5). So depois da migracao de public.mapas para PRIMARY KEY (database/README.md).
PG_ESCRITA_USER=<defina_no_shell>
PG_ESCRITA_PASSWORD=<defina_no_shell>
