# TesteMetry - SOMENTE nomes das variaveis com placeholders. NAO coloque segredos reais aqui.
# O programa NAO carrega este arquivo automaticamente: defina as variaveis no shell (ver README.md).
PG_HOST=192.168.168.106
PG_PORT=5432
PG_DATABASE=casaos
PG_USER=<seu_usuario>
PG_PASSWORD=<sua_senha>
# Disable | Prefer (padrao) | Require | VerifyCA | VerifyFull  -> recomendado Require ou VerifyFull
PG_SSLMODE=Require
# 4326 (padrao, WGS 84) | 4674 (SIRGAS 2000) | 3857 (Web Mercator) | 31983 (SIRGAS 2000 / UTM 23S)
PG_SRID=4326
