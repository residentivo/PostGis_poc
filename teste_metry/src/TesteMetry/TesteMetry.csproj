<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TesteMetry</RootNamespace>
    <AssemblyName>TesteMetry</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- S4: auditoria NuGet de vulnerabilidades em pacotes diretos e transitivos -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- S4: versao estavel FIXA, sem curinga -->
    <PackageReference Include="Npgsql" Version="[10.0.3]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Apenas a chave "Verboso" (sem credenciais - R1) -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TesteMetry.Tests" />
  </ItemGroup>

</Project>
