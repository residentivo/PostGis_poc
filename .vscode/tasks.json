{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-teste-graphy",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/teste_graphy/src/TesteGraphy/TesteGraphy.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-teste-metry",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/teste_metry/src/TesteMetry/TesteMetry.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-api-mapas",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/api_mapas/src/ApiMapas.Api/ApiMapas.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
