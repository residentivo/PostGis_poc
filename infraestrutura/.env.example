# Exemplo do /opt/api_mapas/.env da VM (lido pelo docker compose). SEM segredos:
# as senhas ficam em /opt/api_mapas/segredos (preparar_servidor.sh).
# REGISTRO, API_TAG e POSTGIS_TAG sao gravados pelo implantar.sh a cada implantacao;
# as demais linhas sao mantidas.
REGISTRO=acrpostgispoc.azurecr.io
API_TAG=<build>-<commit>
POSTGIS_TAG=17-3.5-<commit>

# Opcionais (padrao = appsettings.json). Atras do nginx valem para a API inteira.
API_VERBOSO=false
API_LIMITE_REQUISICOES_POR_MINUTO=60
API_LIMITE_ESCRITAS_POR_MINUTO=10
